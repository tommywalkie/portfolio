---
import translations from '../../i18n/portfolio.json';
import { Languages } from 'lucide-react';

interface Props {
  lang: string;
}

const { lang = 'en' } = Astro.props;

const t = translations[lang].sections.languages;
---

<section>
  <h4 class="mb-4 text-primary-900">{t.title}</h4>
  <ul class="space-y-2">
    {t.items.map((item) => (
      <li>
        <div class="flex items-center gap-4">
          <div class="w-8 h-8 flex items-center justify-center mb-auto">
            <Languages className="w-8 h-8 fill-transparent stroke-primary-300 p-1" />
          </div>
          <span class="text-sm text-primary-700">
            <span class="font-semibold">
              {item.name}
            </span>
            <span class="ml-1 font-light text-primary-900">
              {item.level}
            </span>
          </span>
        </div>
      </li>
    ))}
  </ul>
</section>
