---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FilmPlayer from '../components/FilmPlayer';
import translations from '../i18n/portfolio.json';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const t = translations[lang];
---

<Layout>
	<div class="h-dvh flex flex-col w-full overflow-hidden">
		<Header lang={lang} />
		<main class="flex-1 min-h-0 w-full bg-white dark:bg-primary-950">
			<FilmPlayer client:only="react" lang={lang} muteLabel={t.video.mute} unmuteLabel={t.video.unmute} />
		</main>
		<Footer lang={lang} />
	</div>
</Layout>
