{
  "name": "portfolio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "dev": "pnpm --filter website dev",
    "build": "pnpm --filter website build",
    "preview": "pnpm --filter website preview",
    "uv:sync": "pnpm --filter ./apps/film exec uv sync --frozen",
    "film:render": "pnpm --filter ./apps/film run film:v1.1",
    "film:hls": "pnpm --filter ./apps/film run web"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
