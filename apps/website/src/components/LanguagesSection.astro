---
import SectionTitle from './SectionTitle.astro';
import translations from '../i18n/portfolio.json';
import { Languages } from '@lucide/astro';
import '../styles/markdown.css';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;

const t = translations[lang].sections.languages;
---

<section id="languages" aria-labelledby="languages" class="p-4 mb-12 scroll-mt-16">
  <SectionTitle id="languages" aria-label={t.ariaLabel}>
    {t.title}
  </SectionTitle>
  <div class="space-y-6 w-full max-w-4xl mx-auto">
    <div class="p-4 md:p-6 w-full bg-primary-50 dark:bg-primary-900 rounded-lg">
      <ul class="space-y-4">
        {t.items.map((item) => (
          <li>
            <div class="flex items-center gap-5">
              <div class="min-w-12 min-h-12 max-w-12 max-h-12 flex items-center justify-center">
                <Languages class="w-8 h-8 fill-transparent stroke-primary-300 dark:stroke-primary-500" />
              </div>
              <div>
                <div class="font-semibold text-lg text-primary-900 dark:text-primary-100">
                  <span>{item.name}</span>
                </div>
                <div class="text-primary-700 dark:text-primary-300 markdown-content">
                  {item.level}
                </div>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
